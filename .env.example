NODE_ENV=development
# [IMPORTANT]: When deploying to production, remove the line below or change it to `COMPOSE_FILE=docker-compose.yml`.
COMPOSE_FILE=docker-compose.dev.yml
PORT=5000

# Database
# Paste your MongoDB Atlas Connection String below (e.g. mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/starter_db?retryWrites=true&w=majority)
DATABASE_URL="mongodb+srv://<your_atlas_username>:<your_atlas_password>@cluster0.xxxxx.mongodb.net/starter_db?retryWrites=true&w=majority"
REDIS_URL="redis://localhost:6379"

# General
FRONTEND_URL="http://localhost:3000"
BACKEND_IMAGE_URL="http://localhost:5000"
# Comma-separated list of allowed CORS origins (used by helmet & cors middleware)
ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"
# Secret for signed cookies — use a long random string in production
COOKIE_SECRET="changeme-use-a-long-random-string-in-production"

# Admin Seed Data
ADMIN_NAME="Super Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your_secure_admin_password"

# Stripe
STRIPE_SECRET_KEY="sk_test_123456789"
STRIPE_WEBHOOK_SECRET="whsec_123456789"

# JWT Auth
JWT_SECRET="this-is-a-super-secret-jwt-key-that-is-32-chars"
EXPIRES_IN="1d"
REFRESH_TOKEN_SECRET="this-is-a-super-secret-refresh-key-that-is-32-chars"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Password Reset
RESET_PASS_TOKEN="reset_pass_secret"
RESET_PASS_TOKEN_EXPIRES_IN="10m"
RESET_PASS_LINK="http://localhost:3000/reset-password"

# Email Configuration (Nodemailer)
EMAIL="test@example.com"
APP_PASS="your_app_password"

# AWS S3 Configuration
AWS_S3_REGION="us-east-1"
AWS_S3_ENDPOINT="https://s3.amazonaws.com"
AWS_S3_ACCESS_KEY="your_access_key"
AWS_S3_SECRET_KEY="your_secret_key"
AWS_S3_BUCKET="your_bucket_name"